# Copie como .env en la VPS. Nunca suba .env a GitHub.
DOMAIN=conductores.su-dominio.com
PUBLIC_URL=https://conductores.su-dominio.com
# Genere 32 bytes aleatorios, por ejemplo con secrets.token_hex(32).
SECRET_KEY=
# Cambiar a yes solo después de revisar el texto y URL de autorización.
POLICY_APPROVED=no
POLICY_URL=https://cargalibre.com.co/tratamiento-datos
# Copias cifradas. Clave Fernet conservada también fuera de la VPS.
BACKUP_ENCRYPTION_KEY=
BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Vacío para AWS S3; URL HTTPS para otro almacenamiento compatible.
S3_ENDPOINT_URL=
# Opcional: exige bucket con Object Lock COMPLIANCE habilitado.
BACKUP_LOCK_DAYS=
